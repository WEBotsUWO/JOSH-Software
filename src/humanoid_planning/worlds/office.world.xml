<mvsim_world version="1.0">
  <simul_timestep>5e-3</simul_timestep>

  <gui>
    <cam_distance>20</cam_distance>
  </gui>

  <element class="ground_grid">
    <floating_grid_lines_separation>1.0</floating_grid_lines_separation>
  </element>

  <!-- ========================================== -->
  <!-- REUSABLE TEMPLATES                         -->
  <!-- ========================================== -->
  <block:class name="lab_bench">
    <shape>
      <pt>-0.40 -1.20</pt>
      <pt> 0.40 -1.20</pt>
      <pt> 0.40  1.20</pt>
      <pt>-0.40  1.20</pt>
    </shape>
    <zmin>0.0</zmin>
    <zmax>0.80</zmax>
    <color>#3b6e8c</color>
  </block:class>

  <block:class name="pillar">
    <shape>
      <pt>-0.30 -0.30</pt>
      <pt> 0.30 -0.30</pt>
      <pt> 0.30  0.30</pt>
      <pt>-0.30  0.30</pt>
    </shape>
    <zmin>0.0</zmin>
    <zmax>2.50</zmax>
    <color>#6e6e6e</color>
  </block:class>

  <block:class name="crate">
    <shape>
      <pt>-0.40 -0.40</pt>
      <pt> 0.40 -0.40</pt>
      <pt> 0.40  0.40</pt>
      <pt>-0.40  0.40</pt>
    </shape>
    <zmin>0.0</zmin>
    <zmax>0.75</zmax>
    <color>#b87a3d</color>
  </block:class>

  <!-- ========================================== -->
  <!-- OUTER PERIMETER WALLS (14m x 12m)          -->
  <!-- ========================================== -->
  <!-- North Wall -->
  <block>
    <init_pose>0.0 6.0 0</init_pose>
    <shape><pt>-7.1 -0.1</pt><pt>7.1 -0.1</pt><pt>7.1 0.1</pt><pt>-7.1 0.1</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#8c8c8c</color>
  </block>
  <!-- South Wall -->
  <block>
    <init_pose>0.0 -6.0 0</init_pose>
    <shape><pt>-7.1 -0.1</pt><pt>7.1 -0.1</pt><pt>7.1 0.1</pt><pt>-7.1 0.1</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#8c8c8c</color>
  </block>
  <!-- East Wall -->
  <block>
    <init_pose>7.0 0.0 0</init_pose>
    <shape><pt>-0.1 -6.0</pt><pt>0.1 -6.0</pt><pt>0.1 6.0</pt><pt>-0.1 6.0</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#8c8c8c</color>
  </block>
  <!-- West Wall -->
  <block>
    <init_pose>-7.0 0.0 0</init_pose>
    <shape><pt>-0.1 -6.0</pt><pt>0.1 -6.0</pt><pt>0.1 6.0</pt><pt>-0.1 6.0</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#8c8c8c</color>
  </block>

  <!-- ========================================== -->
  <!-- INTERIOR WALLS & DOORWAYS (1.5m OPENINGS)  -->
  <!-- ========================================== -->
  <!-- Vertical Divider at x = -2.0 (separates West Wing from East Wing) -->
  <!-- Top segment: y = +2.5 to +6.0 -->
  <block>
    <init_pose>-2.0 4.25 0</init_pose>
    <shape><pt>-0.1 -1.75</pt><pt>0.1 -1.75</pt><pt>0.1 1.75</pt><pt>-0.1 1.75</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#a0a0a0</color>
  </block>
  <!-- Middle segment: y = -2.5 to +1.0 (1.5m doorway at y = +1.75) -->
  <block>
    <init_pose>-2.0 -0.75 0</init_pose>
    <shape><pt>-0.1 -1.75</pt><pt>0.1 -1.75</pt><pt>0.1 1.75</pt><pt>-0.1 1.75</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#a0a0a0</color>
  </block>
  <!-- Bottom-most gap at y = -4.0 to -2.5 (1.5m doorway), stub at y = -5.0 -->
  <block>
    <init_pose>-2.0 -5.0 0</init_pose>
    <shape><pt>-0.1 -1.0</pt><pt>0.1 -1.0</pt><pt>0.1 1.0</pt><pt>-0.1 1.0</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#a0a0a0</color>
  </block>

  <!-- Horizontal Divider at y = 0.0 in East Wing (x = -2.0 to +7.0) -->
  <!-- Left segment: x = -2.0 to +1.5 -->
  <block>
    <init_pose>-0.25 0.0 0</init_pose>
    <shape><pt>-1.75 -0.1</pt><pt>1.75 -0.1</pt><pt>1.75 0.1</pt><pt>-1.75 0.1</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#a0a0a0</color>
  </block>
  <!-- Right segment: x = +3.0 to +7.0 (leaves 1.5m doorway at x = +2.25) -->
  <block>
    <init_pose>5.0 0.0 0</init_pose>
    <shape><pt>-2.0 -0.1</pt><pt>2.0 -0.1</pt><pt>2.0 0.1</pt><pt>-2.0 0.1</pt></shape>
    <zmin>0.0</zmin><zmax>2.5</zmax><color>#a0a0a0</color>
  </block>

  <!-- ========================================== -->
  <!-- ROOM FURNITURE & OBSTACLES                 -->
  <!-- ========================================== -->
  <!-- West Corridor / Lobby Pillars -->
  <block class="pillar"><init_pose>-4.5  2.5 0</init_pose></block>
  <block class="pillar"><init_pose>-4.5 -2.5 0</init_pose></block>

  <!-- North-East Room (Lab Benches) -->
  <block class="lab_bench"><init_pose>1.2 3.5 0</init_pose></block>
  <block class="lab_bench"><init_pose>4.5 3.5 0</init_pose></block>

  <!-- South-East Room (Storage Crates) -->
  <block class="crate"><init_pose>1.5 -3.0 20</init_pose></block>
  <block class="crate"><init_pose>4.2 -2.5 -15</init_pose></block>
  <block class="crate"><init_pose>4.8 -4.5 35</init_pose></block>

  <!-- ========================================== -->
  <!-- DIFFERENTIAL-DRIVE ROBOT (0.5m x 0.5m)     -->
  <!-- ========================================== -->
  <vehicle name="robot1">
    <!-- Spawns in South-West Lobby facing North -->
    <init_pose>-4.5 -4.5 90</init_pose>

    <dynamics class="differential">
      <l_wheel pos="0.0  0.21" mass="2.0" width="0.08" diameter="0.22">
        <lateral_friction>0.6</lateral_friction>
      </l_wheel>
      <r_wheel pos="0.0 -0.21" mass="2.0" width="0.08" diameter="0.22">
        <lateral_friction>0.6</lateral_friction>
      </r_wheel>

      <chassis mass="10.0" zmin="0.05" zmax="0.38" restitution="0.2">
        <shape>
          <pt>-0.18 -0.22</pt>
          <pt> 0.18 -0.22</pt>
          <pt> 0.25 -0.14</pt>
          <pt> 0.25  0.14</pt>
          <pt> 0.18  0.22</pt>
          <pt>-0.18  0.22</pt>
          <pt>-0.25  0.14</pt>
          <pt>-0.25 -0.14</pt>
        </shape>
      </chassis>

      <controller class="twist_pid">
        <KP>2.0</KP>
        <KI>0.8</KI>
        <KD>0.05</KD>
        <max_torque>8.0</max_torque>
        <V>0.0</V><W>0</W>
      </controller>
    </dynamics>

    <include file="/opt/ros/jazzy/share/mvsim/definitions/lidar2d.sensor.xml"
             sensor_name="laser1"
             sensor_x="0.12"
             sensor_y="0.0"
             sensor_z="0.41"
             sensor_yaw="0"
             fov_degrees="270"
             sensor_nrays="540" />
  </vehicle>
</mvsim_world>